# CheaperInference
CHEAPERINFERENCE_API_KEY=ci_live_your_key_here
AI_MODEL=gpt-5.6-luna
AI_MAX_TOKENS=3000
CI_RANKING=discount
# Optional hard price floor/discount requirement. Leave unset unless you want requests to fail when the discount is unavailable.
# CI_MIN_DISCOUNT_PERCENT=40
# Optional: only use zero-data-retention routes.
# CI_ZDR=true

# Production distributed rate limits (recommended on Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
API_RATE_LIMIT=120
CHAT_RATE_LIMIT_MINUTE=15
CHAT_RATE_LIMIT_DAY=150
